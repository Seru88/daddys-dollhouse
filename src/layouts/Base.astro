---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Copyright from '../components/Copyright.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const navItems = [
  { href: '/about/', label: 'About' },
  { href: '/rules/', label: 'Rules' },
  { href: '/resources/', label: 'Resources' },
  { href: '/dictionary/', label: 'Dictionary' },
];
const isCurrent = (href: string) => {
  const path = href.replace(/\/$/, '') || '/';
  return currentPath === path || currentPath.startsWith(`${path}/`);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <ClientRouter />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="keywords"
      content="macrophilia, microphilia, shrunken woman, giant man, size fetish, community"
    />
    <meta
      name="description"
      content="An adult forum for fans of giant men and tiny women."
    />
    <meta name="theme-color" content="#D79459" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-180.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/icons/icon-192.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href="/icons/icon-512.png"
    />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title} | Daddy’s Dollhouse</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#page-title">Skip to content</a>

    <header class="site-header">
      <div class="site-header-inner">
        <a
          class="site-brand"
          href="/"
          aria-current={currentPath === '/' ? 'page' : undefined}
        >
          Daddy's Dollhouse
        </a>
        <nav class="site-nav" aria-label="Primary">
          <ul>
            {
              navItems.map(item => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                class="site-nav-forum"
                href="https://forum.daddysdollhouse.org"
              >
                Forum
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="site-main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <Copyright />
        <p class="site-footer-note">Adults only · 18+</p>
      </div>
    </footer>

    <script>
      // ClientRouter swaps the page without moving focus. Move it to the new
      // heading so keyboard and screen-reader users start at the new content.
      document.addEventListener('astro:after-swap', () => {
        const heading = document.querySelector<HTMLElement>('#page-title');
        if (!heading) return;
        heading.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>

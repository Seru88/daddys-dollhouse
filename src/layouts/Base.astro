---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Copyright from '../components/Copyright.astro';
import akaPosseFont from '../fonts/akaPosse.woff2?url';
import courierPrimeRegular from '../fonts/courierPrime-regular.woff2?url';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'An adults-only forum and resource library for fans of giant men and tiny women.',
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const site = Astro.site ?? new URL('https://daddysdollhouse.org');
const pageTitle = `${title} | Daddy’s Dollhouse`;
const canonical = new URL(Astro.url.pathname, site).href;
const socialImage = new URL('/og-default.jpg', site).href;

const navItems = [
  { href: '/about/', label: 'About' },
  { href: '/rules/', label: 'Rules' },
  { href: '/resources/', label: 'Resources' },
  { href: '/dictionary/', label: 'Dictionary' },
];
const isCurrent = (href: string) => {
  const path = href.replace(/\/$/, '') || '/';
  return currentPath === path || currentPath.startsWith(`${path}/`);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <ClientRouter />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow'}
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link
      rel="preload"
      href={akaPosseFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={courierPrimeRegular}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Daddy’s Dollhouse" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Daddy’s Dollhouse artwork" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Daddy’s Dollhouse artwork" />
    <meta name="theme-color" content="#D79459" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-180.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/icons/icon-192.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href="/icons/icon-512.png"
    />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{pageTitle}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#page-title">Skip to content</a>

    <header class="site-header">
      <div class="site-header-inner">
        <a
          class="site-brand"
          href="/"
          aria-current={currentPath === '/' ? 'page' : undefined}
        >
          Daddy’s Dollhouse
        </a>
        <nav class="site-nav" aria-label="Primary">
          <ul>
            {
              navItems.map(item => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                class="site-nav-forum"
                href="https://forum.daddysdollhouse.org"
              >
                Forum
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="site-main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <Copyright />
        <p class="site-footer-note">Adults only · 18+</p>
      </div>
    </footer>

    <script>
      // ClientRouter swaps the page without moving focus. Move it to the new
      // heading so keyboard and screen-reader users start at the new content.
      document.addEventListener('astro:after-swap', () => {
        const heading = document.querySelector<HTMLElement>('#page-title');
        if (!heading) return;
        heading.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>

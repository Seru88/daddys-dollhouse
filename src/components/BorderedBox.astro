---
import { getImage } from 'astro:assets';
import containerInfo from '../images/container_info.webp';

interface Props {
  minHeight?: number;
}

const { minHeight } = Astro.props;

// the frame is drawn from a 350px wide copy - the size the old
// gatsby-image fluid(maxWidth: 350) source used
const frame = await getImage({ src: containerInfo, width: 350 });
---

<div class="bordered-box">
  <div
    class="bordered-box-inner"
    style={`border-image: url(${frame.src}) 50 / 50px repeat;${
      minHeight ? `min-height: ${minHeight}px;` : ''
    }`}
  >
    <slot />
  </div>
</div>

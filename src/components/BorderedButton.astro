---
import ornamentLeft from '../images/ic_decoration_left.webp';
import ornamentRight from '../images/ic_decoration_right.webp';

interface Props {
  href?: string;
  title?: string;
  disabled?: boolean;
  class?: string;
  ornamentPosition?: 'left' | 'right';
}

const {
  href,
  title,
  disabled = false,
  class: className = '',
  ornamentPosition = 'left',
} = Astro.props;

const url = href;
const ornament = ornamentPosition === 'left' ? ornamentLeft : ornamentRight;
const ornamentSide =
  ornamentPosition === 'left' ? 'btn-ornament-left' : 'btn-ornament-right';
const Tag = url ? 'a' : 'button';
const attrs = url
  ? {
      href: url,
      'aria-disabled': disabled ? 'true' : undefined,
      tabindex: disabled ? -1 : undefined,
    }
  : { type: 'button', disabled };
---

<Tag class={`btn ${className}`} title={title} {...attrs}>
  <span class="btn-inner">
    <img
      class={`btn-ornament ${ornamentSide}`}
      src={ornament.src}
      alt=""
      width="24"
      height="24"
    />
    <span class="btn-label"><slot /></span>
  </span>
</Tag>

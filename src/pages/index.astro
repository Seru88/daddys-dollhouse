---
import Base from '../layouts/Base.astro';
import HeroImg from '../components/HeroImg.astro';
import SiteNav from '../components/SiteNav.astro';
import BorderedButton from '../components/BorderedButton.astro';
import { growFade } from '../transitions';
import heroHome from '../images/hero_home.webp';
---

<Base
  title="Home"
  description="Daddy’s Dollhouse is an adults-only community for fans of giant men and tiny women, with resources, community rules and a full size-kink dictionary."
>
  <div class="container">
    <HeroImg src={heroHome} alt="" />
    <SiteNav />
    <div class="page-body padded" transition:animate={growFade}>
      <h1 class="page-title plain" id="page-title" tabindex="-1">
        Welcome to <span class="text-primary">Daddy's Dollhouse</span>
      </h1>
      <div class="home-intro">
        <p class="summary">
          <span class="text-primary">Daddy's Dollhouse</span> is an{' '}
          <span class="text-mature">adults only</span> forum dedicated to the judge-free
          discussion of{' '}
          <span class="text-primary">giant men</span> &amp;{' '}
          <span class="text-primary summary-tiny">tiny women</span>
        </p>
        <BorderedButton
          href="https://forum.daddysdollhouse.org"
          ornamentPosition="left"
          class="btn-enter"
        >
          Enter Forum
        </BorderedButton>
      </div>
    </div>
  </div>
</Base>

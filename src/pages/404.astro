---
import Base from '../layouts/Base.astro';
import BorderedButton from '../components/BorderedButton.astro';
import { growFade } from '../transitions';
---

<Base
  title="Page not found"
  description="The page you were looking for does not exist."
  noindex
>
  <div class="container not-found">
    <div class="page-body padded" transition:animate={growFade}>
      <h1 class="page-title" id="page-title" tabindex="-1">404: Not Found</h1>
      <hr class="divider" />
      <section class="section align-center">
        <p class="lead">
          You just hit a route that doesn't exist... the sadness.
        </p>
        <div class="not-found-cta">
          <BorderedButton href="/" ornamentPosition="left" class="btn-route">
            Return Home
          </BorderedButton>
        </div>
      </section>
    </div>
  </div>
</Base>
